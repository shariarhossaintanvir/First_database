# ==============================================================================
# Environment Configuration Template (SAFE FOR GIT)
# Copy this file to .env and provide your actual local secrets.
# NEVER commit .env or any file containing private keys/secrets to Git.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true

# Firebase Configuration (Public client identifiers)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app

# API & Gateway Endpoints
API_BASE_URL=https://api.example.com
API_TIMEOUT_SECONDS=30

# Third-party Integrations (Placeholders only - do not commit real keys)
STRIPE_PUBLISHABLE_KEY=pk_test_sample_placeholder
MAPS_API_KEY=AIzaSy_sample_placeholder
