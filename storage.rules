rules_version = '2';

// ===============================================================
// Firebase Storage Security Rules
// ===============================================================
//
// Access Control:
// - Product Images: Publicly readable; writable ONLY by authorized admins
// - File constraints: Allowed mime types: image/jpeg, image/png, image/webp, image/gif
// - File size limit: Maximum 5MB (prevents storage quota exhaustion / DoS)
// - Paths: /products/{allPaths=**} and /product_images/{allPaths=**}
// - Default deny: All other paths are locked down
//
// ===============================================================

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'admin@ecommerce.com' && request.auth.token.email_verified == true) ||
        (request.auth.token.email == 'admin@ecommerce.com') ||
        (request.auth.token.keys().hasAny(['admin']) && request.auth.token.admin == true) ||
        (
          firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
          firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'
        )
      );
    }

    function isImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp|gif|jpg)');
    }

    function isValidFileSize() {
      // 5MB limit = 5 * 1024 * 1024 = 5242880 bytes
      return request.resource.size > 0 && request.resource.size <= 5242880;
    }

    // 1. Product Images Folder (legacy & direct file names)
    match /products/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && isImage() && isValidFileSize();
      allow delete: if isAdmin();
    }

    // 2. Structured Product Images Folder (product_images/{productId}/{fileName})
    match /product_images/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && isImage() && isValidFileSize();
      allow delete: if isAdmin();
    }

    // 3. Default deny for all other storage paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
