# ==============================================================================
# Root .gitignore - Multi-App Flutter & Firebase Project
# ==============================================================================

# ------------------------------------------------------------------------------
# 🔐 Sensitive Configuration & Environment Files
# ------------------------------------------------------------------------------
*.env
*.env.*
.env
.env.*
!.env.example
!.env.template
config.local.*
local.config.*
*.secrets.*
secrets/
credentials/
private/

# ------------------------------------------------------------------------------
# 🔥 Firebase Sensitive Files & Credentials
# ------------------------------------------------------------------------------
# Firebase Admin SDK & Service Accounts (CRITICAL: NEVER COMMIT)
*service-account*.json
*serviceAccount*.json
*service_account*.json
*firebase-admin*.json
*admin-sdk*.json
firebase-credentials.json
firebase-adminsdk*.json

# Firebase CLI caches, emulator debug logs & active local configurations
.firebase/
firebase-debug.log
firebase-debug.*.log
firestore-debug.log
ui-debug.log

# ------------------------------------------------------------------------------
# 🛠️ Flutter & Dart Generated Files & Caches
# ------------------------------------------------------------------------------
.dart_tool/
**/.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
**/.flutter-plugins-dependencies
.pub-cache/
.pub/
build/
**/build/
coverage/
**/coverage/
*.lcov
*.g.dart
*.freezed.dart
**/doc/api/
.last_build_id
migrate_working_dir/

# Symbolication & Obfuscation
app.*.symbols
app.*.map.json

# ------------------------------------------------------------------------------
# 🔑 Android & iOS Keystores, Keys, & Local Platform Secrets
# ------------------------------------------------------------------------------
**/android/local.properties
**/android/key.properties
**/android/app/release/
**/android/app/debug/
**/android/app/profile/
**/android/.gradle/
**/android/captures/
**/android/.cxx/
*.keystore
*.jks
*.p12
*.pfx
*.key
*.pem
*.cer
*.crt

# iOS / macOS build caches & Pods
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/app.flx
**/ios/Flutter/app.zip
**/ios/Flutter/flutter_assets/
**/ios/ServiceDefinitions.json
**/ios/Runner/GeneratedPluginRegistrant.*
**/ios/.last_build_id

**/macos/Pods/
**/macos/.symlinks/
**/macos/Flutter/ephemeral/
**/macos/Flutter/GeneratedPluginRegistrant.*

# Windows / Linux desktop build ephemerals
**/windows/flutter/ephemeral/
**/linux/flutter/ephemeral/

# ------------------------------------------------------------------------------
# 💻 IDE, Editor & OS Machine-Specific Files
# ------------------------------------------------------------------------------
# JetBrains / IntelliJ / Android Studio
.idea/
**/.idea/
*.iml
**/*.iml
*.ipr
*.iws
out/
.fleet/

# Visual Studio Code
.vscode/
**/.vscode/
*.code-workspace

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# ------------------------------------------------------------------------------
# 📦 Logs, Diagnostics & Temporary Files
# ------------------------------------------------------------------------------
*.log
**/*.log
*.tmp
*.temp
*.bak
*.swp
*~
debug/
debug.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
